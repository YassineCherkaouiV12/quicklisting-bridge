{
  "manifest_version": 3,
  "name": "QuickListing Connector",
  "version": "1.1.0",
  "description": "Keeps QuickListing connected to Facebook on this computer — shares your Facebook session with the QuickListing desktop app, only when it asks. Localhost only.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": ["https://*.facebook.com/*", "http://127.0.0.1:47615/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickListing Connector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
