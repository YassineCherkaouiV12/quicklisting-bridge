{
  "manifest_version": 3,
  "name": "QuickListing Bridge",
  "version": "1.0.0",
  "description": "Same-machine bridge: shares your live Facebook session with the QuickListing desktop app when it gets signed out. Prototype \u2014 localhost only.",
  "key": "",
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "http://127.0.0.1:47615/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickListing Bridge"
  }
}
